# Featherless AI API Configuration
# Dapatkan API key dari https://featherless.ai
FEATHERLESS_API_KEY=your_featherless_api_key_here

# Model yang akan digunakan
# Pilihan: openai/gpt-oss-120b, deepseek-ai/DeepSeek-V4-Pro, MiniMaxAI/MiniMax-M2.7
FEATHERLESS_MODEL=openai/gpt-oss-120b

# System prompt untuk chatbot (optional)
FEATHERLESS_SYSTEM_PROMPT=You are a helpful AI assistant.

# Tavily Search API Key (untuk web search)
TAVILY_API_KEY=your_tavily_api_key_here

# Cloudflare Account ID (untuk Vectorize - optional)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Cloudflare API Token (untuk Vectorize - optional)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Nama index Vectorize (optional)
VECTORIZE_INDEX_NAME=chatbot-search-index

# Featherless Embedding Model (optional)
FEATHERLESS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
